Public Class Form1
#Region "Variables"
    Dim leftRigtSpeed As Integer = 5
    Dim upDownSpeed As Integer = 5
    Dim enemyUpDownSpeed As Integer = 5
    Dim enemyUpDownSpeed2 As Integer = 7
    Dim enemyUpDownSpeed3 As Integer = 7
    Dim bullets As New List(Of PictureBox)
#End Region
    Sub makeBullet()
        Dim newBullet As New PictureBox
        With newBullet
            .Width = 10
            .Height = 10
            .BackColor = Color.Red
            .Top = pbPlayer.Top
            .Left = pbPlayer.Left
        End With
        Me.Controls.Add(newBullet)
        bullets.Add(newBullet)
    End Sub


    Private Sub enemyMover_Tick(sender As Object, e As EventArgs) Handles enemyMover.Tick
        pbEnemy.Top += enemyUpDownSpeed
        pbEnemy2.Top += enemyUpDownSpeed2
        pbEnemy3.Left += enemyUpDownSpeed3

        If pbEnemy.Bottom > Me.Height Or pbEnemy.Top < 0 Then
            enemyUpDownSpeed *= -1
        End If
        If pbEnemy2.Bottom > Me.Height Or pbEnemy2.Top < 0 Then
            enemyUpDownSpeed2 *= -1
        End If
        If pbEnemy3.Right > Me.Width Or pbEnemy3.Left < 0 Then
            enemyUpDownSpeed3 *= -1
        End If
    End Sub
    Sub collision(thisEnemy As PictureBox, thisPlayer As PictureBox)
        If (thisPlayer.Bounds.IntersectsWith(thisEnemy.Bounds)) Then
            thisPlayer.Left = 120
            thisPlayer.Top = 80
        End If
    End Sub
    Sub wrapAround(thisPlayer As PictureBox)

        If thisPlayer.Left < 0 Then
            'the player has gone off the left side
            thisPlayer.Left = Me.Width - thisPlayer.Width
        End If
        If thisPlayer.Top < 0 Then
            'The player has gone off the top
            thisPlayer.Top = Me.Height - thisPlayer.Height
        End If
        If thisPlayer.Top > Me.Height Then
            'The player has gone off the bottom.
            thisPlayer.Top = 0
        End If
        If thisPlayer.Right > Me.Width Then
            'The player has gone off the right.
            thisPlayer.Left = 0
        End If

    End Sub
    Private Sub Form1_KeyDown(sender As Object, e As KeyEventArgs) Handles Me.KeyDown
        If e.KeyCode = Keys.Up Then
            wrapAround(pbPLayerKeyUp)
            If upDownSpeed = -5 Then
                leftRigtSpeed = 0
                upDownSpeed = 0
            Else
                leftRigtSpeed = 0
                upDownSpeed = -5
            End If
        End If
    End Sub
    Private Sub Form1_KeyPress(sender As Object, e As KeyPressEventArgs) Handles Me.KeyPress
        wrapAround(pbPlayer)
        If e.KeyChar = "a" Then
            pbPlayer.Left -= 5
        End If
        If e.KeyChar = "w" Then
            pbPlayer.Top -= 5
        End If
        If e.KeyChar = "s" Then
            pbPlayer.Top += 5
        End If
        If e.KeyChar = "d" Then
            pbPlayer.Left += 5
        End If
        If e.KeyChar = " " Then
            makeBullet()
        End If

        If e.KeyChar = "q" Then
            Close()
        End If
    End Sub
    Private Sub Timer1_Tick(sender As Object, e As EventArgs) Handles Timer1.Tick
        pbPLayerKeyUp.Left += leftRigtSpeed
        pbPLayerKeyUp.Top += upDownSpeed
        collision(pbEnemy, pbPlayer)
        collision(pbEnemy2, pbPlayer)
        collision(pbEnemy3, pbPlayer)
    End Sub
    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        Timer1.Start()
    End Sub
End Class
